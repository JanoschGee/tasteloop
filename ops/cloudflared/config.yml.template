# Vorlage für ~/.cloudflared/config.yml des Dienstbenutzers.
# Die Credentials-Datei (<TUNNEL_ID>.json) ist ein Secret: bleibt in ~/.cloudflared, nie im Repo.
tunnel: __TUNNEL_ID__
credentials-file: __HOME__/.cloudflared/__TUNNEL_ID__.json
ingress:
  - hostname: __HOSTNAME__
    service: http://127.0.0.1:__WEB_PORT__
  - service: http_status:404
